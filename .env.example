BETTER_AUTH_SECRET=""
DATABASE_URL=""

# Public origin Better Auth builds redirect/callback URLs from.
# Falls back to http://localhost:4175 if unset.
BETTER_AUTH_URL=""

# Comma-separated list of trusted origins (LAN + public domain, etc.)
# e.g. https://appmap.appahouse.com,http://localhost:4175
TRUSTED_ORIGINS=""

# --- Authentik (OIDC) SSO — optional ---
# All three must be set to enable the Authentik provider server-side. When any is
# missing, SSO is skipped and email/password auth still works.
# Redirect URI to register in Authentik (strict match):
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/authentik
AUTHENTIK_CLIENT_ID=""
AUTHENTIK_CLIENT_SECRET=""
# Discovery URL: https://<authentik-host>/application/o/<app-slug>/.well-known/openid-configuration
AUTHENTIK_DISCOVERY_URL=""

# Client-readable flag that shows the "Authentik" button on the login screen.
# Set to "true" only when the AUTHENTIK_* vars above are configured.
VITE_AUTHENTIK_ENABLED=""
